"""
ComposeWithLLM - FL Studio Piano Roll Script for MCP Integration

This script enables AI assistants to control FL Studio's piano roll by:
1. Reading note requests from mcp_request.json
2. Adding/deleting/clearing notes in the piano roll
3. Exporting the current state to piano_roll_state.json

Trigger: Cmd+Opt+Y (macOS) or Ctrl+Alt+Y (Windows)

Based on work from https://github.com/calvinw/fl-studio-mcp
"""

import flpianoroll as flp
import json
import os
import random


def get_script_dir():
    """Get the directory where this script is located"""
    return os.path.expanduser("~/Documents/Image-Line/FL Studio/Settings/Piano roll scripts")


REQUEST_FILE = os.path.join(get_script_dir(), "mcp_request.json")
RESPONSE_FILE = os.path.join(get_script_dir(), "mcp_response.json")
STATE_FILE = os.path.join(get_script_dir(), "piano_roll_state.json")


def export_piano_roll_state():
    """Export current piano roll state to JSON file"""
    notes_data = []
    ppq = flp.score.PPQ

    # Collect all notes
    for i in range(flp.score.noteCount):
        note = flp.score.getNote(i)
        notes_data.append({
            "number": note.number,
            "midi": note.number,  # Alias for convenience
            "time": note.time / ppq if ppq > 0 else 0,  # Convert to quarter notes
            "time_ticks": note.time,
            "duration": note.length / ppq if ppq > 0 else 0,  # Convert to quarter notes
            "length_ticks": note.length,
            "velocity": note.velocity,
            "pan": note.pan,
            "color": note.color,
            "fcut": note.fcut,
            "fres": note.fres,
            "slide": note.slide,
            "porta": note.porta,
            "pitchofs": note.pitchofs,
            "selected": note.selected,
            "muted": note.muted,
        })

    # Export metadata
    export_data = {
        "ppq": ppq,
        "noteCount": flp.score.noteCount,
        "notes": notes_data
    }

    # Save to file
    with open(STATE_FILE, 'w') as f:
        json.dump(export_data, f, indent=2)

    return STATE_FILE


def process_mcp_request():
    """Check for and process all requests from the MCP server"""
    if not os.path.exists(REQUEST_FILE):
        return None

    try:
        with open(REQUEST_FILE, 'r') as f:
            content = json.load(f)

        # Handle both single request (old format) and list of requests (new format)
        if isinstance(content, list):
            requests = content
        elif isinstance(content, dict) and content.get("action"):
            requests = [content]
        else:
            # Empty or invalid
            return None

        if not requests:
            return None

        # Process all requests in order
        total_notes = 0
        notes_deleted = 0
        notes_transposed = 0
        notes_humanized = 0
        notes_quantized = 0
        time_signature = None
        markers_data = None
        timeline_selection = None

        for request in requests:
            action = request.get("action")

            if action == "transpose":
                result = transpose_notes_in_piano_roll(request)
                if result and result.get("status") == "success":
                    notes_transposed += result.get("notes_transposed", 0)
            elif action == "humanize":
                result = humanize_notes_in_piano_roll(request)
                if result and result.get("status") == "success":
                    notes_humanized += result.get("notes_humanized", 0)
            elif action == "quantize":
                result = quantize_notes_in_piano_roll(request)
                if result and result.get("status") == "success":
                    notes_quantized += result.get("notes_quantized", 0)
            elif action == "clear":
                # Clear all notes
                count = flp.score.noteCount
                for i in range(count - 1, -1, -1):
                    flp.score.deleteNote(i)
                notes_deleted += count
            elif action == "delete_notes":
                result = delete_notes_from_piano_roll(request)
                if result and result.get("status") == "success":
                    notes_deleted += result.get("notes_deleted", 0)
            elif action == "add_chord":
                result = add_chord_to_piano_roll(request)
                if result and result.get("status") == "success":
                    total_notes += result.get("notes_added", 0)
            elif action == "add_notes":
                result = add_notes_to_piano_roll(request)
                if result and result.get("status") == "success":
                    total_notes += result.get("notes_added", 0)
            elif action == "get_time_signature":
                # Project-level time signature (read-only). Not the playlist
                # time signature markers, which the API does not expose.
                time_signature = {
                    "numerator": flp.score.tsnum,
                    "denominator": flp.score.tsden,
                }
            elif action == "get_markers":
                markers_data = collect_markers()
            elif action == "get_timeline_selection":
                timeline_selection = collect_timeline_selection()

        # Clear the request queue after processing
        with open(REQUEST_FILE, 'w') as f:
            f.write("[]")

        response = {
            "status": "success",
            "requests_processed": len(requests),
            "notes_added": total_notes,
            "notes_deleted": notes_deleted,
            "notes_transposed": notes_transposed,
            "notes_humanized": notes_humanized,
            "notes_quantized": notes_quantized
        }

        # Surface the time signature at the top level so the MCP server can read
        # it directly from the response file.
        if time_signature is not None:
            response["numerator"] = time_signature["numerator"]
            response["denominator"] = time_signature["denominator"]

        if markers_data is not None:
            response["markerCount"] = markers_data["markerCount"]
            response["markers"] = markers_data["markers"]

        if timeline_selection is not None:
            response.update(timeline_selection)

        return response

    except Exception as e:
        return {"status": "error", "message": str(e)}


def add_chord_to_piano_roll(request):
    """Add a chord's notes to the piano roll from MCP request.

    Chord format allows setting a base time and duration for all notes,
    with optional per-note offsets and durations.

    Request format:
    {
        "action": "add_chord",
        "time": 0,           # Base time in quarter notes
        "duration": 1.0,     # Default duration for all notes
        "notes": [
            {"midi": 60},                    # Uses base time and duration
            {"midi": 64, "offset": 0.5},     # Starts 0.5 beats after base time
            {"midi": 67, "duration": 2.0},   # Custom duration
        ]
    }
    """
    try:
        notes = request.get("notes", [])
        ppq = flp.score.PPQ
        chord_time = request.get("time", 0)
        current_time = int(ppq * chord_time)
        duration_multiplier = request.get("duration", 1.0)

        for note_data in notes:
            midi_note = flp.Note()
            midi_note.number = note_data["midi"]
            midi_note.time = current_time + int(ppq * note_data.get("offset", 0))
            note_duration = note_data.get("duration", duration_multiplier)
            midi_note.length = int(ppq * note_duration)
            midi_note.velocity = note_data.get("velocity", 0.8)
            flp.score.addNote(midi_note)

        return {
            "status": "success",
            "notes_added": len(notes)
        }

    except Exception as e:
        return {"status": "error", "message": str(e)}


def delete_notes_from_piano_roll(request):
    """Delete specific notes from the piano roll.

    Request format:
    {
        "action": "delete_notes",
        "notes": [
            {"midi": 60, "time": 0},
            {"midi": 64, "time": 0},
        ]
    }
    """
    try:
        notes_to_delete = request.get("notes", [])
        ppq = flp.score.PPQ
        deleted_count = 0

        # Convert delete criteria to ticks for comparison
        delete_criteria = []
        for note_data in notes_to_delete:
            delete_criteria.append({
                "midi": note_data["midi"],
                "time": int(ppq * note_data["time"])
            })

        # Iterate backward through existing notes and delete matches
        for i in range(flp.score.noteCount - 1, -1, -1):
            note = flp.score.getNote(i)
            for criteria in delete_criteria:
                if note.number == criteria["midi"] and note.time == criteria["time"]:
                    flp.score.deleteNote(i)
                    deleted_count += 1
                    break

        return {
            "status": "success",
            "notes_deleted": deleted_count
        }

    except Exception as e:
        return {"status": "error", "message": str(e)}


def add_notes_to_piano_roll(request):
    """Add arbitrary notes to the piano roll from MCP request.

    Request format:
    {
        "action": "add_notes",
        "notes": [
            {"midi": 60, "time": 0, "duration": 1.0, "velocity": 0.8},
            {"midi": 64, "time": 1.0, "duration": 0.5},
        ]
    }
    """
    try:
        notes = request.get("notes", [])
        ppq = flp.score.PPQ

        for note_data in notes:
            midi_note = flp.Note()
            midi_note.number = note_data["midi"]
            note_time = note_data.get("time", note_data.get("offset", 0))
            midi_note.time = int(ppq * note_time)
            midi_note.length = int(ppq * note_data["duration"])
            midi_note.velocity = note_data.get("velocity", 0.8)
            flp.score.addNote(midi_note)

        return {
            "status": "success",
            "notes_added": len(notes)
        }

    except Exception as e:
        return {"status": "error", "message": str(e)}


def collect_markers():
    """Collect all piano roll markers with type-specific data.

    Marker modes: 0 none, 6 pattern length, 8 time signature (tsnum/tsden),
    9 start recording, 10 stop recording, 12 key/scale (scale_root/helper).
    """
    ppq = flp.score.PPQ
    markers = []
    for i in range(flp.score.markerCount):
        m = flp.score.getMarker(i)
        entry = {
            "index": i,
            "name": m.name,
            "time_ticks": m.time,
            "time": m.time / ppq if ppq > 0 else 0,
            "mode": m.mode,
        }
        if m.mode == 8:  # time signature marker
            entry["tsnum"] = m.tsnum
            entry["tsden"] = m.tsden
        elif m.mode == 12:  # key/scale marker
            entry["scale_root"] = m.scale_root
            entry["scale_helper"] = m.scale_helper
        markers.append(entry)
    return {"markerCount": flp.score.markerCount, "markers": markers}


def collect_timeline_selection():
    """Collect the piano roll timeline selection.

    FL signals "no selection" inconsistently (the stub says start is -1, but in
    practice end can come back as -1 with start 0), so require both endpoints to
    be non-negative and end > start.
    """
    ppq = flp.score.PPQ
    start, end = flp.score.getTimelineSelection()
    has_selection = start >= 0 and end >= 0 and end > start
    return {
        "has_selection": has_selection,
        "selection_start_ticks": start,
        "selection_end_ticks": end,
        "selection_start_beats": (start / ppq if ppq > 0 and has_selection else None),
        "selection_end_beats": (end / ppq if ppq > 0 and has_selection else None),
    }


def _use_selected_scope(selected_only):
    """Return whether to operate on selected notes only.

    True when selected_only is set AND at least one note is selected; otherwise
    operations apply to all notes (standard FL "no selection = all" behavior).
    """
    if not selected_only:
        return False
    for i in range(flp.score.noteCount):
        if flp.score.getNote(i).selected:
            return True
    return False


def humanize_notes_in_piano_roll(request):
    """Add random timing/velocity variation to notes (in place).

    Request: {"action": "humanize", "timing": beats, "velocity": 0-1,
              "selected_only": bool}
    """
    try:
        timing = float(request.get("timing", 0.05))
        velocity_amt = float(request.get("velocity", 0.1))
        selected_only = request.get("selected_only", True)
        ppq = flp.score.PPQ
        use_selected = _use_selected_scope(selected_only)

        n = 0
        for i in range(flp.score.noteCount):
            note = flp.score.getNote(i)
            if use_selected and not note.selected:
                continue
            if timing > 0:
                offset = int(random.uniform(-timing, timing) * ppq)
                note.time = max(0, note.time + offset)
            if velocity_amt > 0:
                v = note.velocity + random.uniform(-velocity_amt, velocity_amt)
                note.velocity = max(0.0, min(1.0, v))
            n += 1
        return {"status": "success", "notes_humanized": n}
    except Exception as e:
        return {"status": "error", "message": str(e)}


def quantize_notes_in_piano_roll(request):
    """Snap note start times toward a grid (in place).

    Request: {"action": "quantize", "grid": beats, "strength": 0-1,
              "selected_only": bool}
    """
    try:
        grid = float(request.get("grid", 0.25))
        strength = float(request.get("strength", 1.0))
        selected_only = request.get("selected_only", True)
        ppq = flp.score.PPQ
        grid_ticks = grid * ppq
        if grid_ticks <= 0:
            return {"status": "error", "message": "grid must be > 0"}
        use_selected = _use_selected_scope(selected_only)

        n = 0
        for i in range(flp.score.noteCount):
            note = flp.score.getNote(i)
            if use_selected and not note.selected:
                continue
            snapped = round(note.time / grid_ticks) * grid_ticks
            new_time = note.time + (snapped - note.time) * strength
            note.time = int(round(new_time))
            n += 1
        return {"status": "success", "notes_quantized": n}
    except Exception as e:
        return {"status": "error", "message": str(e)}


def transpose_notes_in_piano_roll(request):
    """Transpose notes in the piano roll by a number of semitones.

    Operates on selected notes only when selected_only is true and at least one
    note is selected; otherwise transposes all notes. Modifying the Note object
    returned by getNote updates the score in place (standard FL idiom).

    Request format:
    {
        "action": "transpose",
        "semitones": 12,
        "selected_only": true
    }
    """
    try:
        semitones = int(request.get("semitones", 0))
        selected_only = request.get("selected_only", True)

        count = flp.score.noteCount
        any_selected = False
        if selected_only:
            for i in range(count):
                if flp.score.getNote(i).selected:
                    any_selected = True
                    break
        use_selected = selected_only and any_selected

        transposed = 0
        for i in range(count):
            note = flp.score.getNote(i)
            if use_selected and not note.selected:
                continue
            new_number = note.number + semitones
            if new_number < 0:
                new_number = 0
            elif new_number > 127:
                new_number = 127
            note.number = new_number
            transposed += 1

        return {
            "status": "success",
            "notes_transposed": transposed,
            "scope": "selected" if use_selected else "all",
        }

    except Exception as e:
        return {"status": "error", "message": str(e)}


def apply(form=None):
    """
    AUTO MODE - Processes requests silently without dialog

    This script is designed to be triggered automatically via Ctrl+Alt+Y (Windows)
    or Cmd+Opt+Y (macOS).

    It processes pending requests and updates the state without showing any UI.
    """

    # Step 1: Process any pending requests
    result = process_mcp_request()

    # Step 2: Always export state AFTER processing
    # This ensures Claude sees the updated piano roll state
    try:
        export_piano_roll_state()
    except Exception as e:
        # Silent error handling - no UI shown
        pass

    # Step 3: Write result to response file
    if result:
        try:
            with open(RESPONSE_FILE, 'w') as f:
                json.dump(result, f, indent=2)
        except:
            pass
